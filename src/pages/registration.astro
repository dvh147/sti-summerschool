---
import BaseLayout from "../layouts/BaseLayout.astro";
import RegistrationForm from "../components/RegistrationForm.astro";
import PaymentDetails from "../components/PaymentDetails.astro";
import { site, withBase } from "../site";

// Driven by `registrationOpen` in src/site.ts so the form and every
// "Register" call-to-action across the site flip together. Everything below
// stays wired up and tested — flipping the flag back on re-enables the form,
// the payment callout, and the lede that points people at the form.
const registrationOpen = site.registrationOpen;

---

<BaseLayout title="Registration">
  <section class="section">
    <div class="container-narrow prose">
      <p class="eyebrow">Registration</p>
      <h1>{registrationOpen ? "Register for STI 2026" : "Registration"}</h1>
      {registrationOpen && (
        <p class="lede">
          Whether you are presenting a paper or joining as a participant, please fill in
          the registration form below. Payment instructions follow by email.
        </p>
      )}

      {!registrationOpen && (
        <div class="callout closed-notice">
          <h2 style="margin-top:0;">Registration is closed</h2>
          <p>
            We closed registration on {site.deadlines.registration.label} and are no
            longer taking sign-ups through this page.
          </p>
          <p style="margin-bottom:0;">
            Please email <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>{" "}
            if you would still like to attend, need a confirmation of payment, or have
            any question about a registration you already made.
          </p>
        </div>
      )}

      <div class="fee-box">
        <div>
          <div class="fee-amount">{site.fee}</div>
          <div class="fee-label">per participant</div>
        </div>
        <ul class="fee-includes">
          <li>All presentations and keynotes</li>
          <li>Lunches and refreshments on all three days</li>
          <li>Welcome reception and beach dinner on 8 September</li>
          <li>Materials and program</li>
        </ul>
      </div>

      <p class="help">
        Travel and accommodation are not included — see the
        <a href={withBase("/venue")}>Venue page</a> for guidance.
      </p>

      {registrationOpen && (
        <p>
          <strong>Registration deadline:</strong> {site.deadlines.registration.label}.
        </p>
      )}
    </div>
  </section>

  {registrationOpen && <RegistrationForm />}

  <PaymentDetails beforeRegistering={registrationOpen} />
</BaseLayout>

<style>
  /* Registration-closed notice: warm border so it reads as a status change
     rather than the accent-blue informational callouts used elsewhere. */
  .closed-notice {
    border-left-color: var(--color-warm);
    background: color-mix(in srgb, var(--color-warm) 12%, var(--color-surface));
  }
  .closed-notice h2 {
    border-bottom: none;
    padding-bottom: 0;
    font-size: 1.3rem;
  }

  .fee-box {
    display: flex;
    gap: 2rem;
    align-items: center;
    padding: 1.25rem 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    margin: 1.5rem 0;
    flex-wrap: wrap;
  }
  .fee-amount {
    font-family: var(--font-serif);
    font-size: 2.4rem;
    color: var(--color-primary-700);
    line-height: 1;
  }
  .fee-label {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  .fee-includes {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--color-ink);
  }
  .fee-includes li {
    margin-bottom: 0.2rem;
  }
</style>
