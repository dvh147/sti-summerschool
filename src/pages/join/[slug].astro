---
// Unlisted registration page for invited participants.
//
// The public /registration page is closed (site.registrationOpen === false),
// but a handful of people still need to sign up. This page carries the same
// form, posting to the same Worker endpoint, so their details land in D1 and
// show up in /admin exactly like any other registration.
//
// The URL segment comes from the PUBLIC_INVITE_SLUG build variable, NOT from
// this file, so the secret is never committed to the public mirror repo.
// When the variable is unset, getStaticPaths returns nothing and no page is
// built at all — there is deliberately no guessable default. Rotate the link
// by changing the variable and re-running the deploy; the old URL then 404s.
import BaseLayout from "../../layouts/BaseLayout.astro";
import RegistrationForm from "../../components/RegistrationForm.astro";
import PaymentDetails from "../../components/PaymentDetails.astro";
import { site } from "../../site";

export function getStaticPaths() {
  const slug = (import.meta.env.PUBLIC_INVITE_SLUG || "").trim();
  return slug ? [{ params: { slug } }] : [];
}
---

<BaseLayout title="Registration (by invitation)" noindex>
  <section class="section">
    <div class="container-narrow prose">
      <p class="eyebrow">Registration</p>
      <h1>Register for STI 2026</h1>

      <div class="callout invite-notice">
        <p style="margin-top:0;">
          <strong>You have been sent this link personally.</strong>
        </p>
        <p style="margin-bottom:0;">
          General registration has closed, but you can still sign up here. Please
          do not share this link — anyone who has it can register. If a colleague
          needs a place, ask them to email{" "}
          <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a> and we
          will send them their own link.
        </p>
      </div>

      <div class="fee-box">
        <div>
          <div class="fee-amount">{site.fee}</div>
          <div class="fee-label">per participant</div>
        </div>
        <ul class="fee-includes">
          <li>All presentations and keynotes</li>
          <li>Lunches and refreshments on all three days</li>
          <li>Welcome reception and beach dinner on 8 September</li>
          <li>Materials and program</li>
        </ul>
      </div>

      <p class="help">
        Travel and accommodation are not included — see the
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/venue`}>Venue page</a>
        for guidance.
      </p>
    </div>
  </section>

  <RegistrationForm source="registered via invitation link" />

  <PaymentDetails beforeRegistering />
</BaseLayout>

<style>
  .invite-notice {
    border-left-color: var(--color-warm);
    background: color-mix(in srgb, var(--color-warm) 12%, var(--color-surface));
  }

  .fee-box {
    display: flex;
    gap: 2rem;
    align-items: center;
    padding: 1.25rem 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    margin: 1.5rem 0;
    flex-wrap: wrap;
  }
  .fee-amount {
    font-family: var(--font-serif);
    font-size: 2.4rem;
    color: var(--color-primary-700);
    line-height: 1;
  }
  .fee-label {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  .fee-includes {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--color-ink);
  }
  .fee-includes li {
    margin-bottom: 0.2rem;
  }
</style>
