---

<BaseLayout title="Program">
  <section class="section">
    <div class="container-narrow prose">
      <p class="eyebrow eyebrow-lg page-title">Program</p>
      <p class="lede">
        Three days of keynotes, contributed papers, poster slams, industry sessions,
        and a panel on AI and innovation in Europe — all in a single track, so
        everyone sees everything.
      </p>

      <p class="actions">
        <a href={withBase("/docs/STI-2026-Program.pdf")} class="btn btn-primary" download>
          Download the program (PDF)
        </a>
        <a href={withBase("/venue")} class="btn btn-outline">Venue &amp; travel</a>
      </p>

      <div class="callout">
        <p style="margin-top:0;"><strong>Preliminary program — subject to change.</strong></p>
        <p style="margin-bottom:0;">
          Presenters in paper sessions have 15 minutes each; the last part of every
          session is reserved for questions and discussion. Each poster presenter has
          4 minutes to pitch their work during the Poster Slam, followed by a coffee
          break dedicated to the posters. The final version of the program will be
          available a few days before the event.
        </p>
      </div>

      <nav class="daynav" aria-label="Jump to a day">
        {days.map((d) => <a href={`#${d.id}`}>{d.date.split(",")[0]}</a>)}
      </nav>

      {
        days.map((day) => (
          <section class="day" id={day.id}>
            <h2>{day.date}</h2>
            <ol class="slots">
              {day.slots.map((slot) => (
                <li class={`slot slot-${slot.kind}`}>
                  <div class="slot-time">{slot.time}</div>
                  <div class="slot-body">
                    <div class="slot-head">
                      <h3>{slot.title}</h3>
                      {slot.chair && <span class="chair">Chair: {slot.chair}</span>}
                    </div>

                    {slot.theme && <p class="theme">{slot.theme}</p>}
                    {slot.note && <p class="note">{slot.note}</p>}
                    {slot.postersId && (
                      <details class="posters">
                        <summary>
                          <span class="summary-open">
                            Show the {slamById[slot.postersId].posters.length} poster pitches
                          </span>
                          <span class="summary-close">Hide the poster pitches</span>
                        </summary>
                        <ul class="poster-list">
                          {slamById[slot.postersId].posters.map((p) => (
                            <li>
                              <p class="talk-title">{p.title}</p>
                              <p class="people">
                                <strong>{p.name}</strong>
                                <span class="aff"> ({p.affiliation})</span>
                              </p>
                            </li>
                          ))}
                        </ul>
                      </details>
                    )}

                    {slot.speakers && (
                      <p class="people">
                        {speakerList(slot.speakers).map((p, i) => (
                          <>
                            {i > 0 && <span>, </span>}
                            <strong>{p.name}</strong>
                            {p.affiliation && <span class="aff"> ({p.affiliation})</span>}
                          </>
                        ))}
                      </p>
                    )}

                    {slot.items && (
                      <ul class="talks">
                        {slot.items.map((item) => (
                          <li>
                            {item.title && <p class="talk-title">{item.title}</p>}
                            <p class="people">
                              {speakerList(item.speakers).map((p, i) => (
                                <>
                                  {i > 0 && <span>, </span>}
                                  <strong>{p.name}</strong>
                                  {p.affiliation && <span class="aff"> ({p.affiliation})</span>}
                                </>
                              ))}
                              {item.tag && <span class="tag">{item.tag}</span>}
                            </p>
                          </li>
                        ))}
                      </ul>
                    )}

                    {slot.hosts && (
                      <p class="people">
                        <span class="role">Hosts:</span>{" "}
                        {speakerList(slot.hosts).map((p, i) => (
                          <>
                            {i > 0 && <span> &amp; </span>}
                            <strong>{p.name}</strong>
                            <span class="aff"> ({p.affiliation})</span>
                          </>
                        ))}
                      </p>
                    )}
                    {slot.panellists && (
                      <ul class="talks">
                        {slot.panellists.map((p) => (
                          <li>
                            <p class="people">
                              <strong>{p.name}</strong>
                              <span class="aff"> ({p.affiliation})</span>
                            </p>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ))
      }

      <h2>Keynote speakers</h2>
      <div class="keynote-grid">
        {
          keynotes.map((k) => (
            <article class="keynote-card">
              <div class="keynote-photo" aria-hidden="true">
                {k.photo ? (
                  <img src={withBase(k.photo)} alt={`${k.name} portrait`} loading="lazy" />
                ) : (
                  <span class="initials">
                    {k.name
                      .split(" ")
                      .map((n) => n[0])
                      .join("")}
                  </span>
                )}
              </div>
              <h3>{k.name}</h3>
              <p class="affiliation">{k.affiliation}</p>
              {k.talk && <p class="talk">{k.talk}</p>}
              <p class="bio">{k.bio}</p>
            </article>
          ))
        }
      </div>

      <p class="footnote">
        Questions about the program? Get in touch at
        <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-title {
    font-size: clamp(2rem, 1.4rem + 2.5vw, 3rem);
    letter-spacing: 0.04em;
    margin-bottom: 1.25rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* --- Day navigation --- */
  .daynav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0.5rem;
  }
  .daynav a {
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-primary);
  }
  .daynav a:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }

  /* --- Schedule --- */
  .day {
    scroll-margin-top: 5rem;
  }
  .slots {
    list-style: none;
    margin: 1.25rem 0 2.5rem;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .slot {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 0 1.25rem;
    padding: 0.9rem 1.1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-left: 4px solid var(--color-line);
    border-radius: var(--radius-sm);
  }
  .slot-keynote {
    border-left-color: var(--color-primary);
  }
  .slot-papers,
  .slot-posters {
    border-left-color: var(--color-accent);
  }
  .slot-industry,
  .slot-panel {
    border-left-color: var(--color-warm);
  }
  .slot-social {
    border-left-color: var(--color-warm);
  }
  .slot-break,
  .slot-remarks {
    background: transparent;
    padding-block: 0.6rem;
  }
  .slot-time {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-muted);
    padding-top: 0.15rem;
  }
  .slot-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }
  .slot-body h3 {
    margin: 0;
    font-size: 1.05rem;
    color: var(--color-primary-700);
  }
  .slot-break .slot-body h3,
  .slot-remarks .slot-body h3 {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-muted);
  }
  .chair {
    font-size: 0.82rem;
    color: var(--color-muted);
    font-style: italic;
  }
  .theme {
    margin: 0.35rem 0 0;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-accent);
  }
  .note {
    margin: 0.4rem 0 0;
    font-size: 0.88rem;
    color: var(--color-muted);
  }
  .talks {
    list-style: none;
    margin: 0.65rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .talk-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.35;
  }
  .people {
    margin: 0.1rem 0 0;
    font-size: 0.9rem;
  }
  .people .aff {
    color: var(--color-muted);
  }
  .people .role {
    color: var(--color-muted);
    font-style: italic;
  }
  .tag {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
